<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.panels.UmbralizationPanelController" hgap="10" vgap="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <center>
        <VBox spacing="10">
            <Label text="Drag handles, double-click to add, or right-click to remove." alignment="CENTER"/>
            <Canvas fx:id="gradientCanvas" width="256" height="50"/>
        </VBox>
    </center>
    <right>
        <VBox spacing="10">
            <Label text="Values"/>
            <ListView fx:id="thresholdListView" prefHeight="150"/>
            <Button text="Add" onAction="#addThreshold"/>
            <Button text="Remove" onAction="#removeThreshold"/>
        </VBox>
    </right>
    <bottom>
        <HBox alignment="CENTER">
            <Button text="Apply" onAction="#applyThresholding"/>
        </HBox>
    </bottom>
</BorderPane>
