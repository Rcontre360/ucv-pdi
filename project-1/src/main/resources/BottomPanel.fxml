<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<?import javafx.geometry.Insets?>
<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.BottomPanelController" spacing="10" style="-fx-background-color: #333333;">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Button text="-" onAction="#zoomOut"/>
    <Label fx:id="zoomLabel" text="x1.0"/>
    <Button text="+" onAction="#zoomIn"/>
    <Button text="Rotate -90°" onAction="#rotateNeg90"/>
    <Button text="Rotate 90°" onAction="#rotate90"/>
</HBox>
