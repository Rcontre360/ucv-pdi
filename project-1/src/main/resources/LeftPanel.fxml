<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.LeftPanelController" spacing="10">
    <fx:include fx:id="infoPanel" source="InfoPanel.fxml"/>
    <Label fx:id="brightnessValueLabel" text="Brightness: 0.00"/>
    <Slider fx:id="brightnessSlider" min="-100" max="100" value="0"/>
    <Label fx:id="contrastValueLabel" text="Contrast: 0.00"/>
    <Slider fx:id="contrastSlider" min="0" max="100" value="0"/>
    <Button text="Grayscale" onAction="#applyGrayscale"/>
    <Button text="Negative" onAction="#applyNegative"/>
    <HBox spacing="10">
        <Button text="Pick Color" onAction="#selectColor"/>
        <Region fx:id="colorDisplay" style="-fx-background-color: white; -fx-border-color: black;" prefWidth="20" prefHeight="20"/>
    </HBox>
</VBox>
