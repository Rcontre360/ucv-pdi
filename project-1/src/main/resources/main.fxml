<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" style="-fx-background-color: #222222;">
    <top>
        <fx:include fx:id="topPanel" source="TopPanel.fxml"/>
    </top>
    <left>
        <fx:include fx:id="leftPanel" source="LeftPanel.fxml" prefWidth="200"/>
    </left>
    <right>
        <fx:include fx:id="rightPanel" source="RightPanel.fxml" prefWidth="200"/>
    </right>
    <bottom>
        <fx:include fx:id="bottomPanel" source="BottomPanel.fxml"/>
    </bottom>
    <center>
        <ImageView fx:id="imageView" fitWidth="600" fitHeight="400" preserveRatio="true"/>
    </center>
</BorderPane>
