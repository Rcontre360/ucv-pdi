<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Spinner?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.panels.QuantizationPanelController" spacing="10" alignment="TOP_CENTER">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Quantization Method:" style="-fx-font-weight: bold;"/>
    <ComboBox fx:id="methodComboBox" prefWidth="200"/>

    <!-- K-Means specific controls will go here -->
    <VBox fx:id="kmeansControls" spacing="5" alignment="CENTER_LEFT">
        <Label text="Number of Colors (K):" style="-fx-font-weight: bold;"/>
        <Spinner fx:id="kSpinner" prefWidth="80" editable="true"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Apply" onAction="#applyQuantization"/>
        <Button text="Cancel" onAction="#cancel"/>
    </HBox>
</VBox>
