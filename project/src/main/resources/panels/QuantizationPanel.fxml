<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Spinner?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.pdi.ui.panels.QuantizationPanelController"
      spacing="15"
      alignment="TOP_CENTER"
      prefWidth="300">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Method:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="methodComboBox" prefWidth="260"/>
    </VBox>

    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Num of Colors:" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Spinner fx:id="colorsSpinner" prefWidth="100" editable="true"/>
            <Label fx:id="uniqueColorsLabel" text="Original: 256 colors" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
        </HBox>
    </VBox>

    <HBox spacing="15" alignment="CENTER">
        <padding>
            <Insets top="10"/>
        </padding>
        <Button fx:id="applyButton" text="Apply" onAction="#applyQuantization" prefWidth="80" style="-fx-base: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Cancel" onAction="#cancel" prefWidth="80"/>
    </HBox>
</VBox>