<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.panels.RegionGrowingPanelController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <center>
        <Pane fx:id="imagePane">
            <ImageView fx:id="regionGrowingImageView" preserveRatio="true" />
        </Pane>
    </center>

    <right>
        <VBox spacing="10" style="-fx-padding: 0 0 0 10;">
            <Label text="Mode:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="modeComboBox" prefWidth="150"/>

            <Label text="Connectivity:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="connectivityComboBox" prefWidth="150"/>

            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label text="Max Abs Difference:" />
                <TextField fx:id="maxAbsDiffTextField" text="20" prefWidth="60"/>
            </HBox>

            <Label text="Click the image to place seeds." wrapText="true"/>

            <HBox spacing="10" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="cancelButton" text="Cancel" onAction="#cancel"/>
                <Button fx:id="applyButton" text="Apply" onAction="#apply"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
