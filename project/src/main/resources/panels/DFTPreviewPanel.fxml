<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.CheckBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.panels.DFTPreviewPanelController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <center>
        <ImageView fx:id="dftImagePanel" preserveRatio="true" fitWidth="500" fitHeight="500"/>
    </center>

    <right>
        <VBox spacing="10" style="-fx-padding: 0 0 0 10;">
            <VBox spacing="5">
                <Label text="Frequency Domain:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="domainComboBox" prefWidth="150"/>
            </VBox>

            <VBox fx:id="visualizationBox" spacing="5">
                <Label text="Visualization:" style="-fx-font-weight: bold;"/>
                <CheckBox fx:id="phaseCheckBox" text="Show Phase Image" />
            </VBox>

            <Separator/>

            <VBox spacing="5">
                <Label text="Filter Type:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="filterTypeComboBox" prefWidth="150"/>
            </VBox>

            <VBox spacing="5">
                <Label fx:id="thresholdLabel" text="Threshold: 0%" style="-fx-font-weight: bold;"/>
                <Slider fx:id="thresholdSlider" min="0" max="100" value="0"/>
            </VBox>

            <Separator/>

            <Label text="Filter Preview:" style="-fx-font-weight: bold;"/>
            <ImageView fx:id="filterMaskPreview" fitWidth="150" fitHeight="150" preserveRatio="true"/>

            <HBox spacing="10" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="applyButton" text="Apply" onAction="#applyFilter" prefWidth="70"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#cancel" prefWidth="70"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>