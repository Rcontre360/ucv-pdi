<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.RightPanelController" spacing="15" alignment="TOP_RIGHT" style="-fx-background-color: #CCCCCC; -fx-min-width: 220;">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <VBox spacing="8" alignment="TOP_RIGHT" style="-fx-border-color: #AAAAAA; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
        <Label text="Convolution Filters" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="typeComboBox" prefWidth="150"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Rows:"/>
            <TextField fx:id="rowsField" text="3" prefWidth="40"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Cols:"/>
            <TextField fx:id="colsField" text="3" prefWidth="40"/>
        </HBox>

        <VBox spacing="4" alignment="TOP_RIGHT">
            <Label text="Profiling Factor:"/>
            <HBox alignment="CENTER_RIGHT">
                <fx:include fx:id="profilingFactorAdjuster" source="ValueAdjuster.fxml"/>
            </HBox>
        </VBox>

        <Button text="Edit Kernel Matrix" onAction="#showKernel" maxWidth="150"/>
        <Button text="Apply Filter" onAction="#applyFilter" maxWidth="150"/>
        <Button fx:id="removeBlurButton" text="Remove Blur (Wiener)" onAction="#applyRemoveBlur" maxWidth="150" disable="true"/>
    </VBox>

    <VBox spacing="8" alignment="TOP_RIGHT" style="-fx-border-color: #AAAAAA; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
        <Label text="Apply Borders" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="bordersComboBox" prefWidth="150"/>
        <Button text="Detect Borders" onAction="#applyBorders" maxWidth="150"/>
    </VBox>

    <VBox spacing="8" alignment="TOP_RIGHT">
        <Label text="Morphology" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="morphComboBox" prefWidth="150"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Rows:"/>
            <TextField fx:id="morphRowsField" text="3" prefWidth="40"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Cols:"/>
            <TextField fx:id="morphColsField" text="3" prefWidth="40"/>
        </HBox>

        <Button text="Edit Structuring Element" onAction="#showMorphologyEditor" maxWidth="150"/>
        <Button text="Apply Morphology" onAction="#applyMorphology" maxWidth="150"/>
    </VBox>
</VBox>