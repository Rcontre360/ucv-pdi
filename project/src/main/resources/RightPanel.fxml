<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Pos?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.pdi.ui.RightPanelController" spacing="10" alignment="TOP_RIGHT" style="-fx-background-color: #CCCCCC;">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <VBox spacing="5" alignment="TOP_RIGHT">
        <Label text="Filter Type:"/>
        <ComboBox fx:id="typeComboBox"/>
        <HBox spacing="10" alignment="TOP_RIGHT">
            <Label text="Kernel Rows:"/>
            <TextField fx:id="rowsField" text="3" prefWidth="40"/>
        </HBox>
        <HBox spacing="10" alignment="TOP_RIGHT">
            <Label text="Kernel Cols:"/>
            <TextField fx:id="colsField" text="3" prefWidth="40"/>
        </HBox>
        <Label text="Profiling Factor"/>
        <fx:include fx:id="profilingFactorAdjuster" source="ValueAdjuster.fxml"/>
        <Button text="Show Kernel" onAction="#showKernel"/>
        <Button text="Apply Filter" onAction="#applyFilter"/>
    </VBox>

    <VBox spacing="5" alignment="TOP_RIGHT">
        <Label text="Border Detection:"/>
        <ComboBox fx:id="operationsComboBox"/>
        <Button text="Apply Border Op" onAction="#applyOperation"/>
    </VBox>
</VBox>